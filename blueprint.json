{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/admin.php?page=nudge-demo",
  "preferredVersions": { "php": "8.2", "wp": "latest" },
  "login": true,
  "steps": [
    { "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "woocommerce" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "wp-mail-logging" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "git:directory", "url": "https://github.com/SUPERMAGIC1111/nudge-demo-playground", "ref": "main", "path": "nudge-demo" }, "options": { "activate": true } },
    { "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; update_option('woocommerce_onboarding_profile', array('skipped'=>true)); update_option('woocommerce_task_list_hidden','yes'); update_option('blogname','NUDGE Demo Shop');" }
  ]
}
